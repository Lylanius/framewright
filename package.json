{
  "name": "framewright",
  "version": "0.4.0",
  "description": "Framewright — a private, offline-first video editor",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/clean-dist.mjs",
    "build:single": "tsc && vite build --mode single",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc",
    "vendor": "node scripts/copy-vendor.mjs",
    "predev": "node scripts/copy-vendor.mjs",
    "prebuild": "node scripts/copy-vendor.mjs",
    "bench": "playwright test -c playwright.perf.config.ts",
    "desktop:shell": "node desktop/build.mjs",
    "desktop": "npm run build && node desktop/build.mjs && electron desktop/out/main.cjs",
    "desktop:dist": "npm run build && node desktop/build.mjs && electron-builder",
    "desktop:linux": "npm run build && node desktop/build.mjs && electron-builder --linux",
    "desktop:win": "npm run build && node desktop/build.mjs && electron-builder --win",
    "desktop:mac": "npm run build && node desktop/build.mjs && electron-builder --mac",
    "mobile:sync": "npm run build && npx cap sync"
  },
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.2",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lobster": "^5.3.0",
    "@fontsource/monoton": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/rubik-mono-one": "^5.3.0",
    "@huggingface/transformers": "^4.3.0",
    "@mediabunny/aac-encoder": "^1.60.0",
    "@mediabunny/mp3-encoder": "^1.60.0",
    "@mediapipe/face_detection": "^0.4.1646425229",
    "@mediapipe/selfie_segmentation": "^0.1.1675465747",
    "gifenc": "^1.0.3",
    "mediabunny": "^1.60.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "png2icons": "^2.0.1",
    "resedit": "^3.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.2"
  },
  "private": true,
  "type": "module"
}
